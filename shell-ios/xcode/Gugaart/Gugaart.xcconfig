// gugaart 的 iOS 宿主：链接设置（M5-1，U-ios-8）。Kotlin 的整页是静态 framework GugaartShell（:shell-ios 的构建阶段出在 ../build/xcode-frameworks/），
// 播放内核 libmpv 和它用到的全部库是 MPVKit 1.0.0（GPL）的静态 xcframework——不在仓库里，在 MPVKIT_XCFRAMEWORKS（上游 player-apple/tools/fetch-mpvkit.sh 下的位置）。
// 换位置：xcodebuild … MPVKIT_XCFRAMEWORKS=<目录>。升级 MPVKit 时照上游 player-apple/binaries.lock 的清单改这里的框架表（系统库同 player-apple 的测试链接）。
MPVKIT_XCFRAMEWORKS = $(HOME)/dev/gugu/third_party/mpvkit/1.0.0/xcframeworks
MPVKIT_SLICE[sdk=iphoneos*] = ios-arm64
MPVKIT_SLICE[sdk=iphonesimulator*] = ios-arm64_x86_64-simulator
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME) $(MPVKIT_XCFRAMEWORKS)/gmp.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/gnutls.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/hogweed.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/lcms2.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libass.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libavcodec.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libavdevice.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libavfilter.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libavformat.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libavutil.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libbluray.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libcrypto.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libdav1d.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libdovi.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libfreetype.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libfribidi.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libharfbuzz.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libluajit.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libmpv.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libplacebo.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libshaderc_combined.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libsmbclient.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libssl.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libswresample.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libswscale.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libuavs3d.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libuchardet.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/Libunibreak.xcframework/$(MPVKIT_SLICE) $(MPVKIT_XCFRAMEWORKS)/nettle.xcframework/$(MPVKIT_SLICE)
LIBRARY_SEARCH_PATHS = $(inherited) $(MPVKIT_XCFRAMEWORKS)/MoltenVK.xcframework/$(MPVKIT_SLICE)
OTHER_LDFLAGS = $(inherited) -framework GugaartShell -framework gmp -framework gnutls -framework hogweed -framework lcms2 -framework Libass -framework Libavcodec -framework Libavdevice -framework Libavfilter -framework Libavformat -framework Libavutil -framework Libbluray -framework Libcrypto -framework Libdav1d -framework Libdovi -framework Libfreetype -framework Libfribidi -framework Libharfbuzz -framework Libluajit -framework Libmpv -framework Libplacebo -framework Libshaderc_combined -framework Libsmbclient -framework Libssl -framework Libswresample -framework Libswscale -framework Libuavs3d -framework Libuchardet -framework Libunibreak -framework nettle -lMoltenVK -lbz2 -lc++ -lexpat -liconv -lresolv -lxml2 -lz -framework AudioToolbox -framework AVFoundation -framework CoreAudio -framework CoreFoundation -framework CoreMedia -framework CoreVideo -framework Metal -framework VideoToolbox -framework QuartzCore -framework IOSurface -framework CoreGraphics -framework CoreText -framework Security -framework SystemConfiguration -framework MediaPlayer
